      reasoning_effort: ${effort}
      rpm: 2000
      tpm: 8000000
      tags: ["CEILING_UNCLASSIFIED", "aws:ca-central-1", "inferred:us-east-1", "inferred:us-east-2", "inferred:us-west-2"]
%{ endfor ~}

  # ── Meta Llama (cross-region inference profiles) ──────────────────────────

  - model_name: meta-llama4-maverick
    litellm_params:
      model: us.meta.llama4-maverick-17b-instruct-v1:0
      litellm_credential_name: aws_bedrock_us_east_1
      tags: ["CEILING_UNCLASSIFIED", "aws:us-east-1", "inferred:us-east-1", "inferred:us-east-2", "inferred:us-west-2"]

