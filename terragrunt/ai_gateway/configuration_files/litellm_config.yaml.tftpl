credential_list:
  - credential_name: azure_openai
    credential_values:
      api_base: os.environ/AZURE_API_BASE
      api_version: "2025-04-01-preview"
    credential_info:
      description: "Azure OpenAI Service (Entra ID workload identity federation)"
  - credential_name: aws_bedrock
    credential_values:
      aws_region_name: ca-central-1
      aws_role_name: arn:aws:iam::986843603702:role/BedrockConsumer-litellm
      aws_session_name: "litellm-bedrock"
    credential_info:
      description: "AWS Bedrock Service (IAM role)"

model_list:
  # ── Anthropic Claude (inference profiles) ────────────────────────────────

  - model_name: claude-haiku-4-5
    litellm_params:
      model: us.anthropic.claude-haiku-4-5-20251001-v1:0
      litellm_credential_name: aws_bedrock
      tags: ["CEILING_UNCLASSIFIED"]

  - model_name: claude-sonnet-4-5
    litellm_params:
      model: us.anthropic.claude-sonnet-4-5-20250929-v1:0
      litellm_credential_name: aws_bedrock
      tags: ["CEILING_UNCLASSIFIED"]

  - model_name: claude-sonnet-4-6
    litellm_params:
      model: us.anthropic.claude-sonnet-4-6
      litellm_credential_name: aws_bedrock
      tags: ["CEILING_UNCLASSIFIED"]

  - model_name: claude-opus-4-5
    litellm_params:
      model: us.anthropic.claude-opus-4-5-20251101-v1:0
      litellm_credential_name: aws_bedrock
      tags: ["CEILING_UNCLASSIFIED"]

  - model_name: claude-opus-4-6
    litellm_params:
      model: us.anthropic.claude-opus-4-6-v1
      litellm_credential_name: aws_bedrock
      tags: ["CEILING_UNCLASSIFIED"]

  # ── Amazon Nova ──────────────────────────────────────────────────────────

  - model_name: amazon-nova-2-lite
    litellm_params:
      model: us.amazon.nova-2-lite-v1:0
      litellm_credential_name: aws_bedrock
      tags: ["CEILING_UNCLASSIFIED"]

  # ── Cohere ───────────────────────────────────────────────────────────────

  - model_name: cohere-embed-english
    litellm_params:
      model: cohere.embed-english-v3
      litellm_credential_name: aws_bedrock
      tags: ["CEILING_UNCLASSIFIED"]

  - model_name: cohere-embed-multilingual
    litellm_params:
      model: cohere.embed-multilingual-v3
      litellm_credential_name: aws_bedrock
      tags: ["CEILING_UNCLASSIFIED"]

  - model_name: cohere-embed-v4
    litellm_params:
      model: bedrock/global.cohere.embed-v4:0
      litellm_credential_name: aws_bedrock
      tags: ["CEILING_UNCLASSIFIED"]

  - model_name: cohere-rerank
    litellm_params:
      model: cohere.rerank-v3-5:0
      litellm_credential_name: aws_bedrock
      tags: ["CEILING_UNCLASSIFIED"]

  # ── Azure OpenAI (workload identity, canary) ────────────────────────────
  # Auth is via Entra ID workload identity federation (AZURE_CLIENT_ID /
  # AZURE_TENANT_ID / AZURE_FEDERATED_TOKEN_FILE, see litellm_ecs.tf and
  # litellm_settings.enable_azure_ad_token_refresh below) -- no api_key.
  # GENERATED from configuration_files/azure_openai_deployments.yaml via
  # templatefile() in litellm_config.tf -- do NOT hand-edit the entries
  # below, edit that YAML file instead (add/remove/reorder deployments
  # there) and re-apply.
  # Each entry is backed by an azurerm_cognitive_deployment named
  # identically to the azure/<name> deployment name (see
  # azure_openai_deployments.tf). That deployment's model_version must be
  # set to a real value before `terragrunt apply` -- until then these will
  # 404 with "The API deployment for this resource does not exist".
%{ for d in azure_deployments ~}
%{ if d.is_new_category ~}

  # ---- ${d.category} ----
%{ endif }
  - model_name: ${d.name}
    litellm_params:
      model: azure/${d.name}
      litellm_credential_name: azure_openai
      tags: ["CEILING_UNCLASSIFIED"]
%{ endfor }
router_settings:
  redis_host: os.environ/REDIS_HOST
  redis_port: os.environ/REDIS_PORT
  redis_password: os.environ/REDIS_PASSWORD

general_settings:
  use_redis_transaction_buffer: true
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  store_model_in_db: false
  store_prompts_in_spend_logs: true

litellm_settings:
  # Lets LiteLLM's azure-identity integration refresh the Entra ID access
  # token from AZURE_FEDERATED_TOKEN_FILE automatically instead of requiring
  # api_key on azure/* model entries above.
  enable_azure_ad_token_refresh: true
  cache: true
  cache_params:
    type: redis
    host: os.environ/REDIS_HOST
    port: os.environ/REDIS_PORT
    password: os.environ/REDIS_PASSWORD